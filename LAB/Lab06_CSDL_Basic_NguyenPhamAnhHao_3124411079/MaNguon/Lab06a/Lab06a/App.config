<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Đổi Data Source theo SQL Server trên máy của bạn.
         Ví dụ: .\SQLEXPRESS hoặc (localdb)\MSSQLLocalDB.
         Initial Catalog phải trùng tên CSDL đã chạy script SQL. -->
    <add name="QLSinhVien"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=QLSinhVien;Integrated Security=True;Connect Timeout=10"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
