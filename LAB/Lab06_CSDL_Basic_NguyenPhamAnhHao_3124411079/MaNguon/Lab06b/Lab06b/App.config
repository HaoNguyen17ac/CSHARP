<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Chạy script tạo QLSinhVien trước. Nếu dùng SQL Express, thay Data Source
         bằng .\SQLEXPRESS hoặc đúng Server name của máy đang sử dụng. -->
    <add name="QLSinhVien" providerName="System.Data.SqlClient"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=QLSinhVien;Integrated Security=True;Connect Timeout=10"/>
  </connectionStrings>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>
</configuration>
